# ================================================================
# Legacy Intercessor - local development environment
# Copy to .env and adjust. Never commit real secrets.
# ================================================================

# ---------------------------------------------------------------- APPLICATION
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:9000,http://localhost:8080

# ---------------------------------------------------------------- DATABASE
DATABASE_URL=postgres://postgres@127.0.0.1:5433/legacy_intercessor?sslmode=disable

# ---------------------------------------------------------------- AUTH
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
INVITE_TTL=72h

# ---------------------------------------------------------------- RATE LIMIT
RATE_LIMIT_PER_MINUTE=100
DISABLE_RATE_LIMIT=false

# ---------------------------------------------------------------- AI PROVIDER
# Leave blank to use the built-in offline draft generator (no API cost).
# Options: openai | gemini | claude
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------- OBJECT STORAGE
# Leave blank to store exports on local disk under LOCAL_STORAGE_DIR.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL=10m
LOCAL_STORAGE_DIR=./var/exports

# ---------------------------------------------------------------- RENDERER
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux/Docker:    /usr/bin/chromium
CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
EXPORT_TIMEOUT_SECONDS=30
EXPORT_BASE_URL=http://localhost:8080
TEMPLATE_DIR=./templates
MAX_EXPORT_CONCURRENCY=1

# ---------------------------------------------------------------- SEEDING
# Creates the admin account on first boot. Set true to also create the
# 4 intercessors and a viewer for demos.
SEED_DEMO_USERS=true
DEFAULT_USER_PASSWORD=LegacyIntercessor#2026

# ---------------------------------------------------------------- MONITORING
SENTRY_DSN=
LOG_LEVEL=info
